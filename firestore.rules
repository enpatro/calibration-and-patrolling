rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calibration/{docId} { allow read, write: if request.auth != null; }
    match /patrolling/{docId} { allow read, write: if request.auth != null; }
    match /auditLogs/{docId} { allow read, create: if request.auth != null; }
  }
}
